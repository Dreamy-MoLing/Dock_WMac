{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Windows MSVC x64",
      "description": "Native Windows build with MSVC and Qt6",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_GENERATOR_INSTANCE": "C:/Program Files/Microsoft Visual Studio/18/Insiders",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/msvc2022_64"
      }
    },
    {
      "name": "debug",
      "displayName": "Windows MSVC x64 Debug",
      "description": "Debug build with MSVC and Qt6",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (Windows MSVC x64)",
      "description": "CI build — VS 和 Qt 路径通过环境变量注入。生成器由 workflow YAML 动态传入（-G flag）",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_GENERATOR_INSTANCE": "$env{VS_INSTALL_PATH}",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
        "BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "description": "Build for Windows (Release)"
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "description": "Build for Windows (Debug)"
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "description": "Build for CI (Release)"
    }
  ]
}
