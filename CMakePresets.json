{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Linux (native)",
      "description": "Native Linux build with system Qt6",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-cross",
      "displayName": "Windows (vcpkg cross-compile)",
      "description": "Cross-compile for Windows x64 using vcpkg + mingw",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build_mxe",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "/opt/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/mingw-windows-x64.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "description": "Build natively for Linux"
    },
    {
      "name": "windows-cross",
      "configurePreset": "windows-cross",
      "description": "Cross-compile for Windows"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "description": "Run tests on Linux",
      "environment": {
        "QT_QPA_PLATFORM": "offscreen"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
