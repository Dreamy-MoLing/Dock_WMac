{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Linux (native)",
      "description": "Native Linux build with system Qt6",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-cross",
      "displayName": "Windows (MXE cross-compile)",
      "description": "Cross-compile for Windows x64 using MXE (Docker image: dock-wmac-mxe)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build_win",
      "toolchainFile": "${sourceDir}/cmake/toolchain-mxe-win64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "description": "Build natively for Linux"
    },
    {
      "name": "windows-cross",
      "configurePreset": "windows-cross",
      "description": "Cross-compile for Windows"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "description": "Run tests on Linux",
      "environment": {
        "QT_QPA_PLATFORM": "offscreen"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
