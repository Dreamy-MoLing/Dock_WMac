# Keep source and project text stable across Windows, macOS, and Linux.
* text=auto

# Source, project, scripts, and docs use LF in the working tree and repository.
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.idl text eol=lf
*.xaml text eol=lf
*.vcxproj text eol=lf
*.filters text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.sln text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
.gitattributes text eol=lf

# Binary files must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.dll binary
*.pdb binary
*.winmd binary
